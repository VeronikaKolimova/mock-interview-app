# Backend Environment Variables
# Скопируйте этот файл в .env и заполните вашими ключами

# LLM API Keys (выберите один)
GROQ_API_KEY=ваш_groq_api_key_здесь
OPENROUTER_API_KEY=ваш_openrouter_api_key_здесь

# Supabase Configuration
SUPABASE_URL=https://ваш-проект.supabase.co
SUPABASE_KEY=ваш_anon_key_здесь

# Server Settings
PORT=8001

# Optional: TTS Settings
ELEVENLABS_API_KEY=ваш_elevenlabs_api_key_здесь
